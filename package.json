{
  "name": "@wyre-ai/printix-mcp",
  "version": "0.1.0",
  "description": "MCP server for Printix's Cloud Print API - printer/queue, site, workstation, user, and group management",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "printix-mcp": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WYRE-AI/printix-mcp"
  },
  "homepage": "https://github.com/WYRE-AI/printix-mcp",
  "scripts": {
    "build": "tsup",
    "prebuild": "npm run clean",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "printix",
    "print-management",
    "mcp",
    "msp",
    "model-context-protocol"
  ],
  "author": "WYRE Technology",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.0.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "semantic-release": "^25.0.9",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "zod": "4.3.6"
  }
}
