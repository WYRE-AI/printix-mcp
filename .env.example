# Printix Cloud Print API credentials, obtained through the Printix
# Administrator dashboard. Each MSP-managed customer TENANT has its own
# client_id/client_secret pair - this is not a single WYRE-level
# integration credential. Exchanged for a short-lived OAuth access token
# (POST https://auth.printix.net/oauth/token, grant_type=client_credentials).
PRINTIX_CLIENT_ID=
PRINTIX_CLIENT_SECRET=
