# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load these. Do not add them to
# that service's environment or via env_file.
# Each MSP-managed customer tenant has its own client_id/client_secret pair.
# Exchanged for a short-lived OAuth access token
# (POST https://auth.printix.net/oauth/token, grant_type=client_credentials).
PRINTIX_CLIENT_ID=
PRINTIX_CLIENT_SECRET=

# stdio (default) or http
# MCP_TRANSPORT=stdio

# Required to start the HTTP transport. Leave this empty here.
# The process logs an error and exits non-zero when this is empty or a known
# placeholder. Generate a value with: openssl rand -hex 32
# Compose will not start when it is unset. Never commit a real secret.
# The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1 even if MCP_HTTP_HOST is a wider address such as 0.0.0.0.
# A known placeholder secret is still refused.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address. When MCP_HTTP_HOST is unset, the HTTP server binds 127.0.0.1.
# A configured CONDUIT_S2S_SECRET honors this value. The container image sets
# 0.0.0.0. Without a real secret, the listener is forced to 127.0.0.1.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080

# Credential source for HTTP: env (process environment) or gateway (required
# X-Printix-Client-ID and X-Printix-Client-Secret headers; no env fallback).
# The container image and Compose set gateway. Stdio ignores this and reads
# PRINTIX_* from the environment.
# AUTH_MODE=env

# LOG_LEVEL=info
